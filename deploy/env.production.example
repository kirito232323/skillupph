# ---------------------------------------------------------------------------
# SkillUp production environment file
# Copy to:  /var/www/skillup/.env      (chmod 600)
#
# Every value is wrapped in SINGLE QUOTES on purpose. That keeps characters
# like ( ) ! # % @ safe whether the file is read by systemd (EnvironmentFile=)
# or by bash (`set -a; source .env; set +a`). Do not use double quotes.
# ---------------------------------------------------------------------------

# 1) Secret key -------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# WARNING: media/id_documents/*.skid files are encrypted with a key derived
# from this value (tracker/id_crypto.py). Rotating it makes existing encrypted
# ID documents unreadable, so pick one key and keep it.
DJANGO_SECRET_KEY='replace-with-a-long-random-secret'

# 2) Never True in production ----------------------------------------------
DJANGO_DEBUG='False'

# 3) Hosts allowed to reach the app ----------------------------------------
# Only used if you apply the settings.py patch in the guide (Appendix B).
# Comma separated, no spaces. Use your droplet IP and/or domain name.
DJANGO_ALLOWED_HOSTS='152.42.220.199'

# 4) Origins allowed to POST (CSRF) ---------------------------------------
# Scheme matters: http:// for plain IP, https:// once certbot is installed.
DJANGO_CSRF_TRUSTED_ORIGINS='http://152.42.220.199'

# 5) Optional dedicated key for ID encryption ------------------------------
# Leave EMPTY to keep deriving it from DJANGO_SECRET_KEY (current behaviour).
# Setting it changes the key and makes already-encrypted IDs unreadable.
ID_ENCRYPTION_KEY=''

# 6) Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-3.5-flash-lite'

# 7) Outbound email (optional) ---------------------------------------------
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''
