# Copy to .env and fill in. Never commit the real .env file.
# On the dev machine:  export these (or `set -a; source .env; set +a`)
# On the server:       systemd EnvironmentFile= points at this file.

# --- core -------------------------------------------------------------------
DJANGO_SECRET_KEY='replace-with-a-long-random-secret'
DJANGO_DEBUG='True'
DJANGO_ALLOWED_HOSTS='*'
DJANGO_CSRF_TRUSTED_ORIGINS='http://127.0.0.1:8000,http://localhost:8000'

# Optional dedicated key for ID-document encryption. Empty = derived from
# DJANGO_SECRET_KEY. Rotating it makes stored ID scans unreadable.
ID_ENCRYPTION_KEY=''

# --- database (optional; defaults to local sqlite3) -------------------------
# DATABASE_URL='postgres://user:pass@host:5432/skillup'

# --- Google Gemini (AI features are disabled when blank) --------------------
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-3.5-flash-lite'

# --- outbound email (optional; notifications are skipped when blank) --------
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''

# --- skill-match model ------------------------------------------------------
SKILL_ML_FORCE_ACTIVE='True'
SKILL_ML_PRIOR_BLEND='0.5'
